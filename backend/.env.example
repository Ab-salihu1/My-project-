# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
# Local Docker example:   postgresql://postgres:postgres@localhost:5432/fusta_portal
# Render example:         postgresql://user:pass@host:5432/dbname
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fusta_portal"

# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

PORT=4000
NODE_ENV="development"

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
